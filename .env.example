# Salin file ini menjadi .env lalu isi dengan nilai asli dari Supabase
# Project Settings -> API

# URL proyek Supabase, contoh: https://abcdefghijklm.supabase.co
SUPABASE_URL=

# Service Role Key (RAHASIA, hanya dipakai di sisi server)
SUPABASE_SERVICE_ROLE_KEY=

# Port untuk menjalankan lokal (opsional, default 3000)
PORT=3000
